#include <stdio.h> 
#include <stdlib.h> 
#define MAX_NUM 5 

int primeCheck (int isPrime){ 
        int count = 0; 
        if ( isPrime <= 1){ 
                printf("%d is not prime\n",isPrime); 
                return 0; 
        } 
        else{ 
                for(int i = 1; i <= isPrime; i++){ 
                        if (isPrime % i == 0){ 
                                count++; 
                        } 
                } 
                if (count > 2){ 
                        printf("%d is not prime\n", isPrime); 
                        return 0; 
                } 
                else{ 
                        return 1; 
                } 
        } 
} 
int gcd(int x, int y){ 
        while (y!= 0){ 
                int temp = y; 
                y = x%y; 
                x = temp; 
        } 
        return x; 
} 
int lcm(int x, int y){ 
        if (x == 0 || y == 0){ 
                return 0; 
        } 
return (x * y) / gcd(x,y); 
} 
int power(int x, int y){ 
        int pow = 1; 
        if ( y == 0 ){ 
                x = 1; 
                return x; 
        } 
        if (y < 0){ 
                pow = 1 / ( x * pow ); 
                return pow; 
        } 
        for (int i = 0; i < y; i++){ 
                pow = x * pow; 
        } 
        return pow; 
} 

