#include <stdio.h> 
#include <stdlib.h> 
#define MAX_NUM 16 
void sort (int arr[], int size) 
{ 
        int a,b,temp; 
        for (a = 0; a < (size -1); ++a){ 
                for(b = 0; b < size - 1 - a; ++b){ 
                        if (arr[b] > arr [b+1]){ 
                                temp = arr[b+1]; 
                                arr[b+1] = arr[b]; 
                                arr[b] = temp; 
                                } 
                        } 
                } 
        } 
int main(){ 
        FILE * fp = fopen("num.txt","r"); 
        if(fp == NULL) 
        { 
                printf("Error: could not open the file.\n"); 
        } 
        printf("Content of the file named num.txt:\n"); 
        int array [MAX_NUM]; 
        int i = 0; 
        int num; 
        while(fscanf(fp,"%d,",&num) == 1) { 
                printf("%d ", num); 
                array [i] = num; 
                i++; 
        } 
        fclose(fp); 
        printf("\nContent sorted: \n"); 
        sort(array, MAX_NUM); 
        for (int j = 0; j < 16; j ++){ 
                printf("%d ", array[j]); 
        } 
        printf("\n"); 
        return 0; 
} 
